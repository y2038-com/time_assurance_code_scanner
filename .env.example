# Example environment for LLM providers
# Copy to .env and fill in. Never commit real secrets.
#
# Preferred knobs:
#   TACS_LLM_PROVIDER  — optional opt-in default for --llm
#                        (none | ollama | openai | anthropic | gemini)
#   TACS_MODEL         — model id when an LLM provider is used
# Alias also accepted: TACS_PROVIDER (same as TACS_LLM_PROVIDER)
#
# Privacy: CLI default remains --llm none (no external calls) unless you
# pass --llm explicitly or set TACS_LLM_PROVIDER. Source snippets are sent
# to the provider you configure when LLM mode is enabled.

# ---------------------------------------------------------------------------
# Recommended optional provider: Ollama Cloud (free-tier friendly)
# https://ollama.com/search?c=cloud
# ---------------------------------------------------------------------------
# Leave OLLAMA_HOST unset to use https://ollama.com.
# For a local daemon instead: OLLAMA_HOST=http://127.0.0.1:11434
# TACS_LLM_PROVIDER=ollama
OLLAMA_API_KEY=
# Legacy alias (still accepted): OLLAMA_CLOUD_TOKEN=
# Optional; default cloud model:
# TACS_MODEL=gpt-oss:120b-cloud
# Larger / other cloud models may require a subscription.

# ---------------------------------------------------------------------------
# OpenAI example
# ---------------------------------------------------------------------------
# TACS_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# TACS_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Anthropic example
# ---------------------------------------------------------------------------
# TACS_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# TACS_MODEL=claude-sonnet-4-5

# ---------------------------------------------------------------------------
# Google Gemini example
# ---------------------------------------------------------------------------
# Prefer: AI Studio key + Generative Language API + prepaid credits.
# TACS_LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# # or: GEMINI_API_KEY=
# TACS_MODEL=gemini-3.6-flash

# HTTP resilience (useful for Ollama Cloud / WSL / VPN)
# LLM_CONNECT_TIMEOUT_SEC=120
# GEMINI_CONNECT_TIMEOUT_SEC=120
# GEMINI_TIMEOUT_SEC=600
# GEMINI_MAX_OUTPUT_TOKENS=32768

# Optional deployment allowlist (webapp may set this tighter)
# ALLOWED_LLM_PROVIDERS=ollama,openai,anthropic,gemini
