# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Tool / IDE
.idea/
.vscode/
.taskmaster/
*.swp

# Secrets and local config
.env
.env.*
!.env.example
*.pem

# Cloned repositories retained by `tacs repos` (--cache-dir, default .repo_cache)
.repo_cache/

# Scan artifacts (user-controlled; never commit by default)
results/*
!results/README.md
batch_runs/
.findings/
*.findings.json
findings_*.json
*_findings.json
findings.json

# Local working directories (contents gitignored)
inputs/*
!inputs/README.md
# Legacy optional folder; ignore if present
outputs/

# OS
.DS_Store
Thumbs.db
