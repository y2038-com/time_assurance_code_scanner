{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Y2038 Environment Configuration",
  "description": "Environment configuration for Y2038 vulnerability scanner",
  "type": "object",
  "required": [
    "hardware_model",
    "time_t_size_bits", 
    "time_t_signed",
    "time64_functions_available",
    "d_time_bits_supported",
    "d_time_bits_setting",
    "c_library"
  ],
  "properties": {
    "hardware_model": {
      "type": "string",
      "enum": ["ILP32", "LP64"],
      "description": "Hardware architecture model"
    },
    "time_t_size_bits": {
      "type": "integer",
      "enum": [32, 64],
      "description": "Size of time_t in bits"
    },
    "time_t_signed": {
      "type": "string",
      "enum": ["signed", "unsigned"],
      "description": "Whether time_t is signed or unsigned"
    },
    "time64_functions_available": {
      "type": ["boolean", "null"],
      "description": "Whether time64 functions are available. null means unknown: not established by the available environment evidence. Do not infer it from the ABI, which does not imply which entry points a C library ships."
    },
    "d_time_bits_supported": {
      "type": ["boolean", "null"],
      "description": "Whether _TIME_BITS is supported. null means unknown: not established by the available environment evidence. No ABI or time_t width implies C library support for _TIME_BITS."
    },
    "d_time_bits_setting": {
      "type": "string",
      "enum": ["unknown", "not_available", "not_set", "32", "64"],
      "description": "Current _TIME_BITS setting. 'unknown' means not established; 'not_available' asserts the feature is absent, and 'not_set' asserts the build leaves the macro undefined."
    },
    "os_or_rtos": {
      "type": "string",
      "description": "Operating system or RTOS name and version"
    },
    "c_library": {
      "type": "string",
      "enum": ["glibc", "newlib", "picolibc", "musl", "minimal", "libstdc++", "other"],
      "description": "C library implementation"
    },
    "c_library_other_text": {
      "type": "string",
      "description": "Description when c_library is 'other'"
    },
    "toolchain_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(-{1,2}[A-Za-z0-9_][A-Za-z0-9_-]*(=.+)?|-[DU][A-Za-z0-9_]+(=.+)?)$"
      },
      "description": "Toolchain compilation flags"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the environment"
    },
    "scenario_hint": {
      "type": "string",
      "pattern": "^(ILP32|LP64)-(32|64)bit(-(signed|unsigned))?(-time64_(yes|no|unknown))?(-(N/A|_TIME_BITS_(32|64|not_set|unknown)))?$",
      "description": "Derived scenario hint, composed as <hardware_model>-<time_t bits>bit[-<signedness>][-time64_<yes|no|unknown>][-<N/A|_TIME_BITS_<setting>>]. A pattern rather than an enum, because the hint is mechanically assembled from those dimensions and a hand-maintained list of the products drifts from the code that composes them. The time64_unknown form carries through an unknown time64_functions_available rather than reading it as no."
    },
    "mitigation_path": {
      "type": ["string", "null"],
      "enum": ["upgrade_env", "stay_and_patch", null],
      "description": "Required mitigation path for risky scenarios"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["d_time_bits_supported"],
        "properties": {
          "d_time_bits_supported": { "const": false }
        }
      },
      "then": {
        "properties": {
          "d_time_bits_setting": { "const": "not_available" }
        }
      }
    },
    {
      "if": {
        "required": ["d_time_bits_supported"],
        "properties": {
          "d_time_bits_supported": { "const": true }
        }
      },
      "then": {
        "properties": {
          "d_time_bits_setting": { "not": { "const": "not_available" } }
        }
      }
    },
    {
      "if": {
        "required": ["d_time_bits_supported"],
        "properties": {
          "d_time_bits_supported": { "const": null }
        }
      },
      "then": {
        "properties": {
          "d_time_bits_setting": { "not": { "const": "not_available" } }
        }
      }
    },
    {
      "if": {
        "required": ["c_library"],
        "properties": {
          "c_library": { "const": "other" }
        }
      },
      "then": {
        "required": ["c_library_other_text"],
        "properties": {
          "c_library_other_text": { "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "required": ["scenario_hint"],
        "properties": {
          "scenario_hint": {
            "pattern": "^ILP32-32bit-signed-time64_(no|unknown)(-.*)?$"
          }
        }
      },
      "then": {
        "required": ["mitigation_path"],
        "properties": {
          "mitigation_path": { "not": { "const": null } }
        }
      }
    }
  ]
}
